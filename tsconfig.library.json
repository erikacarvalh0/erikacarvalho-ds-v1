{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "incremental": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": true
  },
  "include": [
    "src/library.ts",
    "src/**/*.d.ts"
  ]
}
