{
  "name": "@erikacarvalho/react",
  "version": "1.0.0",
  "scripts": {
    "svgr": "node node_modules/@svgr/cli/bin/svgr --typescript --memo --icon --title-prop -d src/atoms/icons public/images/icons",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:start": "cd dist && PORT=1234 npx serve",
    "start": "webpack serve --open --mode development",
    "start:icons": "yarn svgr && webpack serve --open --mode development",
    "start:live": "yarn svgr && webpack serve --open --mode development --live-reload --hot",
    "build:library": "webpack --config webpack.library.config.js --mode production && tsc -p tsconfig.library.json",
    "prepack": "yarn build:library && node scripts/package-styles.cjs"
  },
  "license": "MIT",
  "author": {
    "name": "Erika Carvalho",
    "email": "scarvalho.erika@outlook.com"
  },
