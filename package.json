{
  "name": "@erikacarvalho/react",
  "version": "1.0.0",
  "scripts": {
    "svgr": "node node_modules/@svgr/cli/bin/svgr --typescript --memo --icon --title-prop -d src/atoms/icons public/images/icons",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:start": "cd dist && PORT=1234 npx serve",
    "start": "webpack serve --open --mode development",
    "start:icons": "yarn svgr && webpack serve --open --mode development",
    "start:live": "yarn svgr && webpack serve --open --mode development --live-reload --hot",
    "build:library": "webpack --config webpack.library.config.js --mode production && tsc -p tsconfig.library.json",
    "prepack": "yarn build:library && node scripts/package-styles.cjs"
  },
  "license": "MIT",
  "author": {
    "name": "Erika Carvalho",
    "email": "scarvalho.erika@outlook.com"
  },
  "devDependencies": {
    "@babel/core": "^7.15.8",
    "@babel/plugin-transform-runtime": "^7.15.8",
    "@babel/preset-env": "^7.15.8",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.10.4",
    "@svgr/cli": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.1.0",
    "babel-loader": "^8.2.2",
    "css-loader": "^6.3.0",
    "dotenv-webpack": "^8.0.1",
    "html-webpack-plugin": "^5.3.2",
    "postcss": "^8.2.1",
    "postcss-loader": "^4.1.0",
    "sass": "^1.70.0",
    "style-loader": "^3.3.0",
    "typescript": "^4.5.2"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.0",
    "rimraf": "^5.0.5",
    "sass-loader": "^14.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.3.1"
  },
  "main": "./lib/index.cjs",
  "types": "./lib/types/library.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/library.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./lib/styles.css",
    "./tokens.css": "./lib/tokens.css",
    "./scss/*": "./lib/scss/*",
    "./Button": {
      "types": "./lib/types/atoms/Button/index.d.ts",
      "import": "./lib/Button.mjs",
      "require": "./lib/Button.cjs"
    }
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "module": "./lib/index.mjs"
}
